# MP Landscape Services Backend Environment Configuration
# Copy this file to .env for local development, or add variables to Vercel Environment Variables in production.

NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mp_landscape?retryWrites=true&w=majority

# Frontend Application Origin (supports comma-separated URLs)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# JWT Authentication Secret (minimum 16 random characters)
JWT_SECRET=your_secure_random_secret_at_least_16_chars
JWT_EXPIRES_IN=1d

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Seed Admin Account (used only for initial db:seed)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@mplandscape.com
ADMIN_PASSWORD=AdminSecurePass123!
